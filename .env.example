NODE_ENV=development
PORT=5000

MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/ridetoroad

JWT_ACCESS_SECRET=change_this_access_secret
JWT_REFRESH_SECRET=change_this_refresh_secret

ADMIN_JWT_ACCESS_SECRET=change_this_admin_access_secret
ADMIN_JWT_REFRESH_SECRET=change_this_admin_refresh_secret

COOKIE_DOMAIN=localhost

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Razorpay (test mode keys from https://dashboard.razorpay.com/app/keys — leave
# blank during development; order-creation will return a clear error until set)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

DEFAULT_WHATSAPP_NUMBER=919310811124
FRONTEND_URL=http://localhost:3000

SUPER_ADMIN_EMAIL=admin@ridetoroad.com
SUPER_ADMIN_PASSWORD=ChangeMe123!

# OTP is dev-mode only until a real SMS provider is wired up (see services/otp.service.ts) —
# in that mode the OTP is returned directly in the API response instead of being texted.
OTP_DEV_MODE=true
